# Frontend environment (Vite). Copy this file to ".env" and fill in the values.
# Where to find them: Supabase dashboard -> Settings -> API
#
# Everything in this file is PUBLIC: variables starting with NEXT_PUBLIC_ or VITE_ are built
# into the JavaScript the browser downloads.
# NEVER put the service_role key here (or in any NEXT_PUBLIC_ / VITE_ variable).
# It belongs only in backend/.env as SUPABASE_SERVICE_ROLE_KEY.

# Project URL (same URL the backend uses)
NEXT_PUBLIC_SUPABASE_URL=https://srv1938257.hstgr.cloud

# "anon public" key (safe for the browser; access is controlled by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# URL of the backend API (Express server)
NEXT_PUBLIC_API_URL=http://localhost:4000
